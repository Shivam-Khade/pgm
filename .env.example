# PGM environment configuration
# Copy to .env and fill in values

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:Shivam10@162006@localhost:5432/pgm

# ── LLM ───────────────────────────────────────────────────
# Provider: "groq" | "openai_compatible" | "anthropic" | "mock"
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
LLM_BASE_URL=

# ── Embeddings ────────────────────────────────────────────
# Provider: "sentence_transformer" | "mock"
EMBEDDER_PROVIDER=mock
EMBEDDER_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ── PGM parameters ───────────────────────────────────────
# Reference population size (default: India ~1.4B)
REFERENCE_POPULATION=1400000000
# Default identification budget in bits
DEFAULT_BUDGET_BITS=20.0
# Minimum anonymity set size
DEFAULT_K_MIN=100
# Dependence discount factor (0=independent, higher=more conservative)
DEPENDENCE_DISCOUNT=0.1

# ── Optimization weights ─────────────────────────────────
LAMBDA_RISK=1.0
MU_COST=0.1
RHO_AGGREGATE=5.0
TAU_UTILITY_FLOOR=0.3

# ── Server ────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
